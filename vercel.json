{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/offline-assets.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/engine/stockfish-18-lite-single.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/engine/stockfish-18-lite-single.js", "headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/icons/icon.svg", "headers": [{ "key": "Content-Type", "value": "image/svg+xml" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/icons/icon-192.png", "headers": [{ "key": "Content-Type", "value": "image/png" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/icons/icon-512.png", "headers": [{ "key": "Content-Type", "value": "image/png" }, { "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
